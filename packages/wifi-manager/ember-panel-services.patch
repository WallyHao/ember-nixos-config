diff --git a/src/ui/proxy.rs b/src/ui/proxy.rs
new file mode 100644
index 0000000..b739df5
--- /dev/null
+++ b/src/ui/proxy.rs
@@ -0,0 +1,250 @@
+//! UI for the bounded Ember proxy helper.
+
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+
+use gtk4::{
+    Align, ApplicationWindow, Box as GtkBox, Button, DropDown, Label, ListItem, Orientation,
+    SignalListItemFactory, StringList, StringObject, glib, pango, prelude::*,
+};
+use gtk4_layer_shell::{KeyboardMode, Layer, LayerShell};
+
+use crate::process;
+use crate::ui::home::HomeTileWidgets;
+
+pub(crate) struct ProxyWidgets {
+    pub(crate) container: GtkBox,
+    pub(crate) status: Label,
+    feedback: Label,
+    enable: Button,
+    disable: Button,
+    load: Button,
+    nodes: StringList,
+    picker: DropDown,
+    apply: Button,
+    names: RefCell<Vec<String>>,
+    current: Cell<u32>,
+    busy: Cell<bool>,
+    helper: String,
+    window: glib::WeakRef<ApplicationWindow>,
+    tile: HomeTileWidgets,
+}
+
+impl ProxyWidgets {
+    pub(crate) fn new(
+        helper: String, window: &ApplicationWindow, tile: HomeTileWidgets,
+    ) -> Rc<Self> {
+        let container = GtkBox::new(Orientation::Vertical, 10);
+        container.set_margin_top(8);
+        container.set_margin_bottom(16);
+        container.set_margin_start(16);
+        container.set_margin_end(16);
+
+        let status = Label::new(Some("Checking proxy service…"));
+        let service_actions = GtkBox::new(Orientation::Horizontal, 8);
+        service_actions.add_css_class("cc-proxy-actions");
+        let enable = Button::with_label("Enable proxy");
+        let disable = Button::with_label("Disable proxy");
+        service_actions.append(&enable);
+        service_actions.append(&disable);
+        container.append(&service_actions);
+
+        let node_heading = Label::new(Some("Proxy node"));
+        node_heading.set_halign(Align::Start);
+        node_heading.add_css_class("cc-section-heading");
+        container.append(&node_heading);
+        let nodes = StringList::new(&[]);
+        let expression =
+            gtk4::PropertyExpression::new(StringObject::static_type(), None::<gtk4::Expression>, "string");
+        let picker = DropDown::new(Some(nodes.clone()), Some(expression));
+        picker.set_hexpand(true);
+        picker.set_enable_search(true);
+        picker.set_tooltip_text(Some("Choose a Mihomo node or select AUTO"));
+        picker.set_factory(Some(&label_factory()));
+        picker.set_list_factory(Some(&label_factory()));
+        let apply = Button::with_label("Apply");
+        let load = Button::with_label("Load nodes");
+        let node_actions = GtkBox::new(Orientation::Horizontal, 8);
+        node_actions.add_css_class("cc-proxy-actions");
+        node_actions.append(&picker);
+        node_actions.append(&apply);
+        node_actions.append(&load);
+        container.append(&node_actions);
+
+        let feedback = Label::new(None);
+        feedback.set_halign(Align::Start);
+        feedback.set_wrap(true);
+        feedback.add_css_class("cc-detail-status");
+        container.append(&feedback);
+
+        let view = Rc::new(Self {
+            container, status, feedback, enable, disable, load, nodes, picker, apply,
+            names: RefCell::new(Vec::new()), current: Cell::new(gtk4::INVALID_LIST_POSITION),
+            busy: Cell::new(false), helper, window: window.downgrade(), tile,
+        });
+        for (button, action) in [
+            (&view.enable, "on"), (&view.disable, "off"),
+            (&view.load, "panel-nodes"), (&view.apply, "select"),
+        ] {
+            let weak = Rc::downgrade(&view);
+            button.connect_clicked(move |_| {
+                if let Some(view) = weak.upgrade() {
+                    view.perform(action);
+                }
+            });
+        }
+        let weak = Rc::downgrade(&view);
+        view.picker.connect_selected_notify(move |picker| {
+            if let Some(view) = weak.upgrade() {
+                let selected = picker.selected();
+                view.apply.set_sensitive(
+                    !view.busy.get() && selected != gtk4::INVALID_LIST_POSITION
+                        && selected != view.current.get()
+                );
+            }
+        });
+        let weak = Rc::downgrade(&view);
+        window.connect_visible_notify(move |window| {
+            if window.is_visible() {
+                if let Some(view) = weak.upgrade() {
+                    view.refresh();
+                }
+            }
+        });
+        view.render_service_state("unknown");
+        view
+    }
+
+    pub(crate) fn refresh(self: &Rc<Self>) {
+        if self.busy.replace(true) {
+            return;
+        }
+        let view = self.clone();
+        glib::spawn_future_local(async move {
+            view.refresh_service().await;
+        });
+    }
+
+    async fn refresh_service(&self) {
+        let result = process::run(&self.helper, ["status"]).await;
+        let state = result.as_ref().ok().filter(|value| value.success())
+            .map_or("unknown", |value| value.stdout.trim());
+        self.busy.set(false);
+        self.render_service_state(state);
+    }
+
+    fn render_service_state(&self, state: &str) {
+        let active = state == "active";
+        let label = match state {
+            "active" => "Proxy is running",
+            "activating" => "Proxy is starting",
+            "deactivating" => "Proxy is stopping",
+            "inactive" => "Proxy is inactive",
+            "failed" => "Proxy service failed",
+            _ => "Proxy service status unavailable",
+        };
+        self.status.set_text(label);
+        self.tile.set_status(Some(label));
+        self.tile.set_active(active);
+        if !active {
+            self.set_nodes("");
+        }
+        let has_nodes = !self.names.borrow().is_empty();
+        self.enable.set_sensitive(!matches!(state, "active" | "activating"));
+        self.disable.set_sensitive(state != "deactivating");
+        self.load.set_sensitive(active);
+        self.picker.set_sensitive(active && has_nodes);
+        let selected = self.picker.selected();
+        self.apply.set_sensitive(active && has_nodes && selected != gtk4::INVALID_LIST_POSITION
+            && selected != self.current.get());
+    }
+
+    fn set_nodes(&self, data: &str) {
+        let mut items = data.split('\0');
+        let current = items.next().unwrap_or_default();
+        let names: Vec<String> = items.map(str::to_owned).collect();
+        let labels: Vec<String> = names.iter().map(|name| display_node(name)).collect();
+        let labels: Vec<&str> = labels.iter().map(String::as_str).collect();
+        let selected = names.iter().position(|name| name == current)
+            .map_or(gtk4::INVALID_LIST_POSITION, |index| index as u32);
+        self.current.set(selected);
+        self.nodes.splice(0, self.nodes.n_items(), &labels);
+        self.picker.set_selected(selected);
+        self.load.set_label(if names.is_empty() { "Load nodes" } else { "Reload nodes" });
+        *self.names.borrow_mut() = names;
+    }
+
+    fn perform(self: &Rc<Self>, action: &'static str) {
+        let mut args = vec![action.to_owned()];
+        if action == "select" {
+            let Some(name) = self.names.borrow().get(self.picker.selected() as usize).cloned() else {
+                return;
+            };
+            args.push(name);
+        }
+        if self.busy.replace(true) {
+            return;
+        }
+        let Some(window) = self.window.upgrade() else {
+            self.busy.set(false);
+            return;
+        };
+        self.enable.set_sensitive(false);
+        self.disable.set_sensitive(false);
+        self.load.set_sensitive(false);
+        self.picker.set_sensitive(false);
+        self.apply.set_sensitive(false);
+        self.feedback.set_text("Waiting for authorization or the proxy service…");
+        // Let the desktop authentication dialog take focus above the panel.
+        window.set_keyboard_mode(KeyboardMode::None);
+        window.set_layer(Layer::Bottom);
+        let view = self.clone();
+        glib::spawn_future_local(async move {
+            let result = process::run(&view.helper, &args).await;
+            window.set_layer(Layer::Top);
+            window.set_keyboard_mode(KeyboardMode::Exclusive);
+            let message = match result {
+                Ok(output) if output.success() => match action {
+                    "panel-nodes" => {
+                        view.set_nodes(&output.stdout);
+                        if view.names.borrow().is_empty() { "No proxy nodes available." } else { "" }
+                    }
+                    "select" => {
+                        view.current.set(view.picker.selected());
+                        "Proxy node selected."
+                    }
+                    "on" => "Proxy enabled. It may wait for a connection.",
+                    _ => "Proxy disabled.",
+                },
+                Ok(output) if output.status == 126 => "Authorization cancelled.",
+                _ => "Proxy operation failed. Check authorization or the proxy service.",
+            };
+            view.feedback.set_text(message);
+            view.refresh_service().await;
+        });
+    }
+}
+
+fn display_node(name: &str) -> String {
+    name.chars().map(|character| if character.is_control() { ' ' } else { character }).collect()
+}
+
+fn label_factory() -> SignalListItemFactory {
+    let factory = SignalListItemFactory::new();
+    factory.connect_setup(|_, object| {
+        let item = object.downcast_ref::<ListItem>().expect("node list item");
+        let label = Label::new(None);
+        label.set_xalign(0.0);
+        label.set_max_width_chars(26);
+        label.set_ellipsize(pango::EllipsizeMode::End);
+        item.set_child(Some(&label));
+    });
+    factory.connect_bind(|_, object| {
+        let item = object.downcast_ref::<ListItem>().expect("node list item");
+        let label = item.child().and_downcast::<Label>().expect("node label");
+        let value = item.item().and_downcast::<StringObject>().expect("node text");
+        label.set_text(&value.string());
+        label.set_tooltip_text(Some(&value.string()));
+    });
+    factory
+}
