#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
repo=$(pwd -P)

usage() {
  cat <<'EOF'
usage: scripts/ember <info|check|build|software-build|proxy|profile|migrate-folio-data|scan-selftest>

  info          show target identity and storage/deployment state
  check         path/secret scans, self-tests, flake eval, and no-build checks
  scan-selftest prove the path and secret scanners reject controlled samples
  build         build the system-preview toplevel (not installable)
  software-build build every declared user-profile package
  proxy [status|on|off|check|import FILE] manage Mihomo
  profile [install|list|history|rollback [N]] manage all declared user software
  migrate-folio-data copy private node/subscription/Wi-Fi data to mounted /mnt

This wrapper is non-interactive; `just apps` and `just vpn` prompt for the
actions that need input. switch, test, boot, install, and activate are not
performed by this wrapper.
EOF
}

require_ember_user() {
  if [ "$(id -u)" -ne 1000 ] || [ "$(id -un)" != wallyhao ] ||
    [[ "$(< /proc/sys/kernel/hostname)" != ember && "$(< /proc/sys/kernel/hostname)" != hearth && "$(< /proc/sys/kernel/hostname)" != forge ]] || [ "$HOME" != /home/wallyhao ]; then
    echo 'Run this command as wallyhao on Ember or Forge, without sudo.' >&2
    return 2
  fi
}

profile_manifest() {
  local profile=$1
  if [ -e "$profile/manifest.json" ]; then
    nix profile list --profile "$profile" --json
  else
    printf '{"elements":{}}\n'
  fi
}

profile_fast_path() {
  local profile="$HOME/.local/state/nix/profiles/profile"
  local manifest="$profile/manifest.json"
  local jqbin="$profile/bin/jq"
  local flake="path:$repo/software"
  local old_flake
  old_flake="path:$(dirname "$repo")/hearth-nixos-config/software"
  local expected_json legacy

  [ -x "$jqbin" ] && [ -e "$manifest" ] && [ -f "$repo/software/bootstrap/packages" ] || return 1
  (cd "$repo" && sha256sum --check --status software/bootstrap/fingerprint) || return 1

  expected_json=$(
    while IFS=$' \t' read -r name paths extra; do
      [ -z "${name:-}" ] && continue
      case "$name" in \#*) continue ;; esac
      [ -n "${paths:-}" ] && [ -z "${extra:-}" ] || return 1
      printf '%s\t%s\n' "$name" "$paths"
    done < "$repo/software/bootstrap/packages" |
      "$jqbin" -Rn '[inputs | split("\t") | {name: .[0], paths: (.[1] | split(","))}]'
  ) || return 1

  legacy=$(cat "$repo/software/bootstrap/legacy-workstations.json") || return 1
  # shellcheck disable=SC2016
  "$jqbin" -e \
    --arg flake "$flake" \
    --arg old "$old_flake" \
    --argjson expected "$expected_json" \
    --argjson legacy "$legacy" '
      def current:
        (.originalUrl == $flake)
        and ((.attrPath // "") | startswith("packages.x86_64-linux."));
      def legacy_entry:
        ((.attrPath // "") == "packages.x86_64-linux.workstation")
        or ((.storePaths // []) | any(.[]; test("-(ember|hearth)-workstation$")))
        or ((.storePaths // []) | any(. as $p | $legacy | index($p) != null));
      .elements as $e
      | ($expected | all(. as $x |
          ($e[$x.name] != null)
          and ($e[$x.name] | current)
          and ((($e[$x.name].storePaths // []) | sort) == ($x.paths | sort))
        ))
        and ([$e | to_entries[] | select(.value | current) | .key]
          | all(. as $key | $expected | map(.name) | index($key) != null))
        and ([$e | to_entries[] | select(.value | legacy_entry)] | length == 0)
    ' "$manifest" >/dev/null
}

profile_reconcile() {
  local profile="$HOME/.local/state/nix/profiles/profile"
  local flake="path:$repo/software"
  local old_flake
  old_flake="path:$(dirname "$repo")/hearth-nixos-config/software"
  local desired_raw entries temp target_jq
  local name key _original attr paths priority kind legacy_flag
  local -a desired_names missing_names changed_keys extra_keys legacy_keys
  local -A desired_lookup target_paths managed_key
  local -i legacy_priority=999
  local conflict=0
  missing_names=()
  changed_keys=()
  extra_keys=()
  legacy_keys=()

  # Nix path flakes can resolve to the enclosing immutable store path when the
  # command starts inside a copied store fixture. Use the user's home for all
  # evaluation/build/profile operations; $repo remains absolute.
  cd "$HOME"

  desired_raw=$(nix eval --raw --no-update-lock-file "$flake#packages.x86_64-linux" \
    --apply 'packages: builtins.concatStringsSep "\n" (builtins.attrNames packages)') || return
  mapfile -t desired_names <<<"$desired_raw"
  if [ "${#desired_names[@]}" -eq 0 ] || [ -z "${desired_names[0]}" ]; then
    echo 'The software flake does not declare any packages.' >&2
    return 1
  fi
  for name in "${desired_names[@]}"; do
    desired_lookup[$name]=1
  done

  # Build the entire declaration before touching the profile. This also
  # provides the expected store paths for an idempotent reconciliation.
  for name in "${desired_names[@]}"; do
    paths=$(nix build --no-link --print-out-paths --no-update-lock-file "$flake#$name" | sort | paste -sd, -) || return
    if [ -z "$paths" ]; then
      echo "The software flake produced no output for $name." >&2
      return 1
    fi
    target_paths[$name]=$paths
    if [ "$name" = jq ]; then
      local -a jq_outputs
      IFS=',' read -r -a jq_outputs <<<"$paths"
      for output in "${jq_outputs[@]}"; do
        if [ -x "$output/bin/jq" ]; then
          target_jq="$output/bin/jq"
        fi
      done
    fi
  done
  if [ -z "$target_jq" ] || [ ! -x "$target_jq" ]; then
    echo 'The software flake did not produce a usable jq.' >&2
    return 1
  fi

  entries=$(profile_manifest "$profile") || return
  temp=$(mktemp) || return
  # shellcheck disable=SC2016
  if ! printf '%s\n' "$entries" | "$target_jq" -r \
    --arg flake "$flake" \
    --arg old "$old_flake" \
    --argjson legacy "$(cat "$repo/software/bootstrap/legacy-workstations.json")" '
      .elements | to_entries[] |
      [
        .key,
        (.value.originalUrl // "-"),
        (.value.attrPath // "-"),
        ((.value.storePaths // []) | sort | join(",")),
        ((.value.priority // 5) | tostring),
        (if ((.value.originalUrl == $flake or .value.originalUrl == $old)
             and ((.value.attrPath // "") | startswith("packages.x86_64-linux.")))
         then "managed" else "-" end),
        (if (((.value.attrPath // "") == "packages.x86_64-linux.workstation")
             or ((.value.storePaths // []) | any(.[]; test("-(ember|hearth)-workstation$")))
             or ((.value.storePaths // []) | any(. as $p | $legacy | index($p) != null)))
         then "legacy" else "-" end)
      ] | @tsv
    ' >"$temp"; then
    rm -f "$temp"
    return 1
  fi

  while IFS=$'\t' read -r key _original attr paths priority kind legacy_flag; do
    [ -n "$key" ] || continue
    if [ "$legacy_flag" = legacy ]; then
      legacy_keys+=("$key")
      if [ "$priority" -lt "$legacy_priority" ]; then
        legacy_priority=$priority
      fi
    elif [ "$kind" = managed ]; then
      name=${attr#packages.x86_64-linux.}
      if [ -n "${managed_key[$name]:-}" ]; then
        echo "Multiple managed profile entries found for $name; inspect the entries with 'just apps'." >&2
        conflict=1
      elif [ -n "${desired_lookup[$name]:-}" ]; then
        managed_key[$name]=$key
        if [ "$paths" != "${target_paths[$name]}" ]; then
          changed_keys+=("$key")
        fi
      else
        extra_keys+=("$key")
      fi
    elif [ -n "${desired_lookup[$key]:-}" ]; then
      echo "Profile entry '$key' is not managed by Ember; refusing to replace it." >&2
      conflict=1
    fi
  done <"$temp"
  rm -f "$temp"

  if [ "$conflict" -ne 0 ]; then
    return 1
  fi

  for name in "${desired_names[@]}"; do
    if [ -z "${managed_key[$name]:-}" ]; then
      missing_names+=("$name")
    fi
  done

  if [ "${#missing_names[@]}" -eq 0 ] && [ "${#changed_keys[@]}" -eq 0 ] &&
    [ "${#extra_keys[@]}" -eq 0 ] && [ "${#legacy_keys[@]}" -eq 0 ]; then
    echo 'Declared software already installed.'
    return 0
  fi

  if [ "${#missing_names[@]}" -gt 0 ]; then
    local -a add_args=(profile add --profile "$profile" --no-update-lock-file)
    mkdir -p "$(dirname "$profile")"
    # Install during an old bundle migration at a higher precedence than the
    # bundle, then remove the bundle only after all new entries succeeded.
    if [ "$legacy_priority" -lt 999 ]; then
      add_args+=(--priority "$((legacy_priority - 1))")
    fi
    for name in "${missing_names[@]}"; do
      add_args+=("$flake#$name")
    done
    nix "${add_args[@]}" || return
  fi

  if [ "${#changed_keys[@]}" -gt 0 ]; then
    nix profile upgrade --profile "$profile" --no-update-lock-file "${changed_keys[@]}" || return
  fi

  if [ "${#extra_keys[@]}" -gt 0 ] || [ "${#legacy_keys[@]}" -gt 0 ]; then
    local -a remove_keys=("${extra_keys[@]}" "${legacy_keys[@]}")
    nix profile remove --profile "$profile" "${remove_keys[@]}" || return
  fi

  echo 'Declared user software installed. Open a new terminal or launcher to use it.'
}

proxy_command() {
  local action=${1:-status}
  case "$action" in
    status | on | off | check | nodes)
      if [ "$#" -gt 1 ]; then
        echo "Usage: scripts/ember proxy $action" >&2
        return 2
      fi
      ;;
    select)
      if [ "$#" -ne 2 ]; then
        echo 'Usage: scripts/ember proxy select NAME' >&2
        return 2
      fi
      ;;
    import)
      if [ "$#" -ne 2 ]; then
        echo 'Usage: scripts/ember proxy import /path/to/provider.yaml' >&2
        return 2
      fi
      ;;
    help | --help | -h)
      echo 'Usage: scripts/ember proxy <status|on|off|check|import FILE|nodes|select NAME>'
      return
      ;;
    *) echo 'Usage: scripts/ember proxy <status|on|off|check|import FILE|nodes|select NAME>' >&2; return 2 ;;
  esac
  require_ember_user || return
  if command -v ember-proxy >/dev/null 2>&1; then
    ember-proxy "$action" "${@:2}"
  elif command -v hearth-proxy >/dev/null 2>&1; then
    # Transitional system generation. Subscription imports need the new daemon.
    hearth-proxy "$action" "${@:2}"
  else
    echo 'Proxy helper missing; apply the Ember system configuration first.' >&2
    return 1
  fi
}

profile_install() {
  require_ember_user || return
  if profile_fast_path; then
    echo 'Declared software already installed.'
    return 0
  fi
  profile_reconcile
}

software_build() {
  local names name
  names=$(nix eval --raw --no-update-lock-file "path:./software#packages.x86_64-linux" \
    --apply 'packages: builtins.concatStringsSep "\n" (builtins.attrNames packages)') || return
  for name in $names; do
    nix build --no-link --print-out-paths --no-update-lock-file "path:./software#${name}" || return
  done
}

profile_command() {
  local action=${1:-install}
  case "$action" in
    help | --help | -h)
      echo 'Usage: scripts/ember profile <install|list|history|rollback [GENERATION]>'
      return
      ;;
    install | list | history)
      if [ "$#" -gt 1 ]; then
        echo "Usage: scripts/ember profile $action" >&2
        return 2
      fi
      ;;
    rollback)
      if [ "$#" -gt 2 ] || { [ "$#" -eq 2 ] && [[ ! "$2" =~ ^[0-9]+$ ]]; }; then
        echo 'Usage: scripts/ember profile rollback [GENERATION]' >&2
        return 2
      fi
      ;;
    *) echo 'Usage: scripts/ember profile <install|list|history|rollback [GENERATION]>' >&2; return 2 ;;
  esac
  require_ember_user || return
  local profile="$HOME/.local/state/nix/profiles/profile"
  case "$action" in
    install) profile_install ;;
    list | history) nix profile "$action" --profile "$profile" ;;
    rollback)
      if [ "$#" -eq 2 ]; then
        nix profile rollback --profile "$profile" --to "$2"
      else
        nix profile rollback --profile "$profile"
      fi
      ;;
  esac
}

refuse() {
  echo "refused: this wrapper does not activate, install, or write firmware." >&2
  echo "Use 'scripts/ember build' for the system-preview only." >&2
  exit 2
}

scan_grep() {
  local root=$1
  local pattern=$2
  local description=$3
  local matches rc=0
  local reviewed_disk=''
  local -a roots

  if [ "$root" = "$repo" ]; then
    roots=(flake.nix flake lib hosts suites inventory users software scripts tests modules packages)
    if [ "$description" = "host/disk reference" ]; then
      reviewed_disk='^hosts/ember/storage-spec[.]nix:[0-9]+:  targetDisk = "/dev/disk/by-id/nvme-eui[.][0-9a-f]{16}";$'
    fi
  else
    roots=("$root")
  fi

  # Keep source lines in memory and emit only file and line number.
  matches=$(grep -rInHE \
    --exclude-dir=.git \
    --exclude-dir=fixtures \
    --exclude=ember \
    --exclude='result*' \
    -- "$pattern" "${roots[@]}" 2>/dev/null) || rc=$?
  case "$rc" in
    0)
      awk -F : -v reviewed_disk="$reviewed_disk" -v description="$description" '
        reviewed_disk != "" && $0 ~ reviewed_disk { next }
        {
          if (!found++) print "forbidden " description ":"
          print $1 ":" $2
        }
        END { exit (found ? 1 : 0) }
      ' <<<"$matches" >&2
      ;;
    1) return 0 ;;
    *)
      echo "scan failed while looking for $description (grep exit $rc)" >&2
      return 2
      ;;
  esac
}

static_scan() {
  local root=${1:-$repo}
  local forbidden='(/home/folio|/dev/nvme[0-9]|/dev/sd[a-z]|/dev/disk/by-id/)'
  local status=0

  scan_grep "$root" "$forbidden" "host/disk reference" || status=$?
  scan_grep "$root" 'UUID=[0-9a-fA-F-]{8,}' "UUID literal" || return "$?"
  return "$status"
}

secret_scan() {
  local root=${1:-$repo}
  local rc

  set +e
  gitleaks dir --no-banner --redact --config "$repo/.gitleaks.toml" "$root"
  rc=$?
  set -e

  case "$rc" in
    0)
      return 0
      ;;
    1)
      echo "secret scan found leaks" >&2
      return 1
      ;;
    *)
      echo "secret scan failed to execute (exit $rc)" >&2
      return 2
      ;;
  esac
}

scan_selftest() (
  local tmp rc
  tmp=$(mktemp -d) || return
  trap 'rm -rf "$tmp"' EXIT

  mkdir -p "$tmp/empty" "$tmp/path/modules" "$tmp/secret"

  if ! static_scan "$tmp/empty"; then
    echo "self-test: empty path scan unexpectedly failed" >&2
    return 1
  fi
  if ! secret_scan "$tmp/empty"; then
    echo "self-test: empty secret scan unexpectedly failed" >&2
    return 1
  fi

  local fake_home scan_output
  fake_home="/home/""folio/example"
  printf 'not a real path: %s\n' "$fake_home" >"$tmp/path/modules/bad.nix"
  rc=0
  scan_output=$(static_scan "$tmp/path" 2>&1) || rc=$?
  if [ "$rc" -ne 1 ] || [[ "$scan_output" != *'/modules/bad.nix:1'* || "$scan_output" == *"$fake_home"* ]]; then
    echo "self-test: path scanner failed to report a redacted modules/bad.nix match" >&2
    return 1
  fi
  rm "$tmp/path/modules/bad.nix"
  printf 'targetDisk = "%s%s";\n' '/dev/disk/' 'by-id/nvme-eui.0000000000000000' >"$tmp/path/modules/bad-disk.nix"
  rc=0
  static_scan "$tmp/path" || rc=$?
  if [ "$rc" -ne 1 ]; then
    echo "self-test: path scanner failed to reject a physical disk in a shared module" >&2
    return 1
  fi

  # Build the sample at runtime so the scanner script itself does not contain
  # a matching credential literal.
  printf 'aws_access_key_id = "AKIA%s"\n' 'Z7Q2X4W6R8T1Y3U5' >"$tmp/secret/leak.txt"
  rc=0
  secret_scan "$tmp/secret" || rc=$?
  if [ "$rc" -ne 1 ]; then
    echo "self-test: secret scanner failed to reject a fake AWS key" >&2
    return 1
  fi

  echo "scanner self-tests passed"
)

# replaceDependencies generates helper derivations lazily; force every check
# derivation to be instantiated before the no-build flake check. Prefer one
# nix-eval-jobs pass; keep the per-check loop for environments without the
# devShell.
force_check_evals() {
  local failed=0 rc=0 log err_log
  if command -v nix-eval-jobs >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    log=$(mktemp)
    err_log=$(mktemp)
    # Two workers keep the combined memory budget inside a normal CI runner;
    # the default worker count would exceed available RAM on a many-core host.
    nix-eval-jobs --workers 2 --flake "path:.#checks.x86_64-linux" >"$log" 2>"$err_log" || failed=1
    if [ -s "$err_log" ]; then
      cat "$err_log" >&2
    fi
    python3 - "$log" <<'PY' || rc=1
import json
import sys

failed = False
with open(sys.argv[1], encoding="utf-8") as handle:
    for line in handle:
        line = line.strip()
        if not line:
            continue
        try:
            job = json.loads(line)
        except json.JSONDecodeError:
            print(f"check eval: unparsable job line: {line}", file=sys.stderr)
            failed = True
            continue
        error = job.get("error")
        if error:
            failed = True
            print(f"check eval failed: {job.get('attr', '?')}: {error}", file=sys.stderr)
sys.exit(1 if failed else 0)
PY
    rm -f "$log" "$err_log"
    if [ "$failed" -ne 0 ] || [ "$rc" -ne 0 ]; then
      return 1
    fi
    return 0
  fi

  for check in vm-accounts vm-persistence vm-offline-link vm-desktop vm-user-environment vm-connectivity; do
    nix eval --raw --no-update-lock-file "path:.#checks.x86_64-linux.${check}.drvPath" >/dev/null
  done
}

main() {
  case "${1:-info}" in
    migrate-folio-data)
      local tool
      tool=$(nix build --no-link --print-out-paths --no-update-lock-file path:.#migration-tool) || return
      exec sudo "$tool/bin/ember-migrate-folio-data" --target-root /mnt
      ;;
    info)
      printf 'hosts: ember (laptop), forge (desktop)\n'
      printf 'user: wallyhao (uid 1000, /home/wallyhao)\n'
      nix eval --json --no-update-lock-file path:.#lib.deployments | python3 -m json.tool
      printf 'system-preview: nix build path:.#packages.x86_64-linux.system-preview\n'
      printf 'system-preview-forge: nix build path:.#packages.x86_64-linux.system-preview-forge\n'
      ;;
    check)
      static_scan
      secret_scan
      scan_selftest
      force_check_evals
      nix flake check --no-build --no-update-lock-file path:.
      ;;
    scan-selftest)
      scan_selftest
      ;;
    build)
      echo "building system-preview; this is not installable and does not touch any disk"
      if command -v nom >/dev/null 2>&1; then
        nom build --no-link --print-out-paths --no-update-lock-file path:.#packages.x86_64-linux.system-preview
      else
        nix build --no-link --print-out-paths --no-update-lock-file path:.#packages.x86_64-linux.system-preview
      fi
      ;;
    software-build)
      software_build
      ;;
    proxy)
      shift
      proxy_command "$@"
      ;;
    profile)
      shift
      profile_command "$@"
      ;;
    switch | test | boot | install | activate)
      refuse
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
